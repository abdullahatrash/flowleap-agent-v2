rm -f /usr/bin/@@NAME@@

# Uninstall the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database for removed workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# NOTE: upstream's postrm continues here by deleting
# /etc/apt/sources.list.d/vscode.sources and /usr/share/keyrings/microsoft.gpg.
# That block is deliberately absent — and it is the more dangerous half: those
# files belong to Microsoft's own VS Code package, so uninstalling FlowLeap
# would have broken apt updates for anyone who also has VS Code installed.
# Do not restore it when porting from upstream.
