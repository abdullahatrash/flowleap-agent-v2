# Symlink bin command to /usr/bin
rm -f /usr/bin/@@NAME@@
ln -s /usr/share/@@NAME@@/bin/@@NAME@@ /usr/bin/@@NAME@@

# Register in the alternatives system. A priority of 0 should never make this
# the default editor in auto mode, as most developers would prefer a terminal
# editor as the default.
update-alternatives --install /usr/bin/editor editor /usr/bin/@@NAME@@ 0

# Install the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database to pickup workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# NOTE: upstream's postinst continues here by registering
# https://packages.microsoft.com/repos/code as an apt source and installing
# Microsoft's signing key into /usr/share/keyrings/microsoft.gpg, behind a
# debconf question. That block is deliberately absent: FlowLeap is distributed
# as direct downloads, so there is no repository to register, and adding a
# third-party package source and trust anchor to a user's machine on install
# would be indefensible. Do not restore it when porting from upstream.
