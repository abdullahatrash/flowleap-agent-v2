exports[`renderFigureOp > refuses 2D numerals that are not under the Figure heading, listing the lines to add 1`] = `
{
  "ok": false,
  "reason": "The steps of FIG. 2 take the numerals listed under its heading in drafting/hinge/figures.md, in order; the figure list is the authority (ADR 0014). The heading lists 3 numeral(s) (2, 4, 6) for 4 steps:
1. measure the temperature
2. compare it with a limit
3. open the valve
4. close the valve
List one numeral per step under the FIG. 2 heading, in step order, then render again.",
}
`;

exports[`renderFigureOp > refuses a 2D Figure whose heading lists nothing (free numerals suggested), another count, or a numeral of another Figure (#786) 1`] = `
{
  "clash": {
    "ok": false,
    "reason": "Numeral 10 under the FIG. 3 heading (drafting/hinge/figures.md, line 48) is already "pipe clamp" of FIG. 1 (line 10). One numeral names one part.
Give each step of FIG. 3 its own numeral of the \`numerals: even\` scheme in drafting/hinge/figures.md, then render again.",
  },
  "fourLines": {
    "ok": false,
    "reason": "The steps of FIG. 3 take the numerals listed under its heading in drafting/hinge/figures.md, in order; the figure list is the authority (ADR 0014). The heading lists 4 numeral(s) (44, 46, 48, 50) for 5 steps:
1. placing the pipe in the saddle groove
2. pivoting the cap about the hinge pin onto the pipe
3. compressing the spring with the cap
4. pushing the locking pin through the latch lug and the cap latch lug
5. releasing the cap, the locking pin holding the cap closed against the spring
List one numeral per step under the FIG. 3 heading, in step order, then render again.",
  },
  "hundredsNoLines": {
    "ok": false,
    "reason": "Every numeral in a Figure is a numeral of the figure list (37 CFR 1.84(p)(5); OJ EPO 2025 A49 Art. 1(2)(i); PCT Rule 11.13(l)). The heading of FIG. 3 in drafting/hinge/figures.md lists no numerals. The blocks of a 2D Figure take the numerals listed under its heading, in order; the next free numerals of the \`numerals: hundreds\` scheme are:
- 302: Pump
- 304: Valve
Add one line per block under the FIG. 3 heading, then render again.",
  },
  "noLines": {
    "ok": false,
    "reason": "Every numeral in a Figure is a numeral of the figure list (37 CFR 1.84(p)(5); OJ EPO 2025 A49 Art. 1(2)(i); PCT Rule 11.13(l)). The heading of FIG. 3 in drafting/hinge/figures.md lists no numerals. The steps of a 2D Figure take the numerals listed under its heading, in order; the next free numerals of the \`numerals: even\` scheme are:
- 44: placing the pipe in the saddle groove
- 46: pivoting the cap about the hinge pin onto the pipe
- 48: compressing the spring with the cap
- 50: pushing the locking pin through the latch lug and the cap latch lug
- 52: releasing the cap, the locking pin holding the cap closed against the spring
Add one line per step under the FIG. 3 heading, then render again.",
  },
}
`;

exports[`renderFigureOp > refuses a part without a numeral 1`] = `
