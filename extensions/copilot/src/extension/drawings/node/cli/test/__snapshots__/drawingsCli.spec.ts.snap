exports[`drawings CLI > refusals > refuses a flowchart from a claim that is not approved and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "A flowchart from a claim needs the Approved Claims. \`approved\` in drafting/widget/claims.md is not \`true\`. The attorney sets \`approved: true\` after review; a statement in chat does not open this gate.",
  "wrote": [],
}
`;

exports[`drawings CLI > refusals > refuses a flowchart proposal that adds a step and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "The diagram was refused:
- Error \`node-count\` (FIG-2.svg): FIG. 2 would have 4 process boxes for 3 steps. The step list is the authority: a proposal may add decisions and edges only, never a step (ADR 0014).",
  "wrote": [],
}
`;

exports[`drawings CLI > refusals > refuses a fourth round and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "FIG. 1 already had 3 review rounds; the limit is 3 per Figure. Edit drafting/widget/drawings/FIG-1.scene.json by hand, or ask the attorney.",
  "wrote": [],
}
`;

