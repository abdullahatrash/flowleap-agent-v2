exports[`drawings CLI > refusals > refuses step numerals that are not under the Figure heading and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "The steps of FIG. 2 take the numerals listed under its heading in drafting/widget/figures.md, in order; the figure list is the authority (ADR 0014). The heading lists 3 numeral(s) (202, 204, 206) for 4 steps:
1. measure the cell temperature
2. compare with the limit
3. open the coolant valve
4. close the valve
List one numeral per step under the FIG. 2 heading, in step order, then render again.",
  "wrote": [],
}
`;

exports[`drawings CLI > refuses a build while a Figure of figures.md is not drawn, and builds it for review with --partial 1`] = `
{
  "figLabels": [
    "FIG. 2",
  ],
  "manifest": "manifest of the export",
  "partial": {
    "exitCode": 0,
    "manifestUpdated": false,
    "missing": [
      "1",
    ],
  },
  "receiptFirstLine": "INCOMPLETE SET: FIG. 1 not drawn",
  "refused": {
    "exitCode": 1,
    "ok": false,
    "reason": "\`figures-missing\`: FIG. 1 of drafting/widget/figures.md is not drawn (37 CFR 1.84(p)(5); OJ EPO 2025 A49 Art. 1(2)(i) (every Figure the description names is in the Drawing Set)). Render it with render_figure first. To review the Figures drawn so far, build with the partial option (\`partial: true\`; CLI \`--partial\`): the receipt then starts with "INCOMPLETE SET" and the Filing Manifest is not changed.",
  },
}
`;

