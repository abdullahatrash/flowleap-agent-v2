  "wrote": [],
}
`;

exports[`drawings CLI > refusals > refuses a build with an open Figure Error and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "2 Error(s) of the Figures are open. Fix each in the Figure source and render again, or the attorney waives it: copy the item under "## Errors" in drafting/widget/findings.md and add a line \`  - Waived: <reason>\` under it.
- \`glyph-too-small\` (FIG-1.svg): Text "10" is 1.43 mm high; the minimum is 3.2 mm.
- \`lead-line-missing\` (FIG-1.svg): Numeral 10 has no lead line and is not underlined as a surface.",
  "wrote": [],
}
`;

