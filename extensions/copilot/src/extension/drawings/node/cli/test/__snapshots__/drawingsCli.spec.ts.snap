// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`drawings CLI > appends a proposal under its Figure heading 1`] = `
{
  "exitCode": 0,
  "figures": "---
numerals: hundreds
---
## FIG. 1

- 10: housing [F1]
- 12: top surface
- 14: bracket (proposed from sketches/sketch-1.png)

## FIG. 2

- 202: measure the temperature
- 204: compare with the limit
- 206: open the valve
",
  "output": {
    "added": "- 14: bracket (proposed from sketches/sketch-1.png)",
    "command": "propose",
    "file": "drafting/widget/figures.md",
    "line": 8,
    "next": "Stop. The attorney confirms the part by removing "(proposed)", or deletes the line. Do not draw the part before that.",
    "ok": true,
  },
}
`;

