// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`drawings CLI > proposes a part with the next numeral of the scheme and copies the sketch 1`] = `
{
  "figures": "---
numerals: hundreds
---
## FIG. 1

- 10: housing [F1]
- 12: top surface
- 102: bracket [F1] (proposed from sketches/photo-of-bracket.png)

## FIG. 2

- 202: measure the temperature
- 204: compare with the limit
- 206: open the valve
",
  "files": [
    "feature-list.md",
    "figures.md",
    "sketches/photo-of-bracket.png",
    "sketches/sketch-1.png",
  ],
  "run": {
    "exitCode": 0,
    "output": {
      "added": "- 102: bracket [F1] (proposed from sketches/photo-of-bracket.png)",
      "command": "propose",
      "file": "drafting/widget/figures.md",
      "next": "This part is a proposal: build and the export stay blocked until the attorney confirms it by removing "(proposed)", or deletes the line. Tell the attorney what you proposed and why, then stop.",
      "ok": true,
      "sketch": "drafting/widget/sketches/photo-of-bracket.png",
    },
  },
}
`;

exports[`drawings CLI > refusals > refuses a 2D Figure with no office and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "Neither drafting/widget/draft-application.md nor drafting/widget/feature-list.md names the office (\`office: US\` or \`office: EPO\`); a 2D Figure follows the office text rules.",
  "wrote": [],
}
`;

exports[`drawings CLI > refusals > refuses a Figure with no heading in figures.md and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "drafting/widget/figures.md has no heading for FIG. 3 (\`## FIG. 3\` with its parts). Add the Figure and its parts to the figure list first.",
  "wrote": [],
}
`;

exports[`drawings CLI > refusals > refuses a build of Letter sheets for the EPO and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "1 Error(s) of the figure list are open; fix each in drafting/widget/figures.md, or the attorney waives it in drafting/widget/findings.md:
- Error \`figures-settings\`: figures.md sets \`pageSize: letter\`, but the EPO accepts A4 sheets only (OJ EPO 2025 A49 Art. 2(2)). Set \`pageSize: A4\`.",
  "wrote": [],
}
`;

exports[`drawings CLI > refusals > refuses a build with a proposal in figures.md and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "drafting/widget/figures.md has 1 proposed part(s); the attorney confirms each by removing "(proposed)", or deletes the line:
- Error \`figure-proposal\` (line 14): Part 14 ("bracket") is a proposal from sketches/sketch-1.png: the disclosure does not state it. The attorney confirms it by removing "(proposed)", or deletes the line.",
  "wrote": [],
}
`;

exports[`drawings CLI > refusals > refuses a build with no rendered Figure and writes no drawing 1`] = `
{
  "exitCode": 1,
