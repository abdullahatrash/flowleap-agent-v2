  "wrote": [],
}
`;

exports[`drawings CLI > refusals > refuses a flowchart proposal that adds a step and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "The diagram was refused:
- Error \`node-count\` (FIG-2.svg): FIG. 2 would have 4 process boxes for 3 steps. The step list is the authority: a proposal may add decisions and edges only, never a step (ADR 0014).",
  "wrote": [],
}
`;

