  "wrote": [],
}
`;

exports[`drawings CLI > refusals > refuses step numerals that are not under the Figure heading and writes no drawing 1`] = `
{
  "exitCode": 1,
  "ok": false,
  "reason": "Every numeral in a Figure is a numeral of the figure list (37 CFR 1.84(p)(5); OJ EPO 2025 A49 Art. 1(2)(i); PCT Rule 11.13(l)). The steps of FIG. 2 take these numerals (\`numerals: hundreds\`), which are not under its heading in drafting/widget/figures.md:
- 208: close the valve
Add these lines under the FIG. 2 heading, then render again.",
  "wrote": [],
}
`;

